# Leash backend configuration. Copy to .env for local runs; never commit .env.
# On Cloud Run the whole file is uploaded as the DOTENV repo secret:
#   gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-philbert-leash < .env
# Service URL: https://ail-ay2627-s1-philbert-leash-464725632804.asia-southeast3.run.app

# REQUIRED. Master secret; every signing key (passes, audit chain, trap keys) is
# derived from it. Generate ONCE before the first deploy and never change it
# (changing it makes every stored audit chain fail verification):
#   python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_SECRET=

# REQUIRED in production. Neon Postgres connection string (must include sslmode=require).
# Tables are created automatically at startup; an empty database is enough.
# Leave blank locally to use a SQLite file (leash.db). Format:
#   postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/leash?sslmode=require
DATABASE_URL=

# REQUIRED in production. Comma-separated origins allowed to call the API (the Vercel site).
# Locally the default is http://localhost:3000.
CORS_ORIGINS=https://ail-ay2627-s1-philbert-leash.vercel.app

# Real AI through OpenRouter. Leave the key blank to run the demo on the free fake AI only.
API_KEY=
# The only model real-AI passes may use (verified on https://openrouter.ai/api/v1/models).
MODEL_NAME=openai/gpt-4o-mini
# USD per 1M tokens for OPENROUTER_MODEL; sizes the worst-case estimate before each call.
# The settled cost uses OpenRouter's reported usage.cost. Defaults match openai/gpt-4o-mini.
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60

# Dollar caps on real AI, kept as running totals in the database.
# Ceiling on all real spend, ever:
GLOBAL_REAL_BUDGET_USD=1.00
# What the public demo may spend in total, and each visitor's share:
PUBLIC_REAL_BUDGET_USD=0.20
SANDBOX_REAL_PER_VISITOR_USD=0.01

# Shared AI Lodge rate limiter (Upstash Redis). Without these, run limits are off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallbacks when the central control sheet has no row: real-AI agent runs per IP per window.
RATE_LIMIT_AGENT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000

# Optional
# DEFAULT_MAX_COMPLETION_TOKENS=300
# SANDBOX_ENABLED=true
